# ─── Gradle ──────────────────────────────────────────────────────────────────
.gradle/
build/
local.properties
.gradletasknamecache

# NOTE: there is deliberately NO blanket `*.jar` rule here. That is the default
# in GitHub's Java .gitignore template, and it silently excludes
# gradle/wrapper/gradle-wrapper.jar — which breaks ./gradlew for everyone who
# clones the repo. Build output is already covered by `build/` above.
# The negation below is belt-and-braces in case a `*.jar` rule ever creeps back.
!gradle/wrapper/gradle-wrapper.jar

# ─── Kotlin ──────────────────────────────────────────────────────────────────
# Kotlin Gradle plugin data (Kotlin 2.x project-level cache).
.kotlin/

# NOTE: kotlin-js-store/yarn.lock is committed ON PURPOSE — it pins the JS
# dependency graph so js/wasmJs builds are reproducible. Do not ignore it.

# ─── Android ─────────────────────────────────────────────────────────────────
*.apk
*.aab
*.ap_
*.dex
captures/
.cxx/
.externalNativeBuild/
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# ─── Xcode / iOS ─────────────────────────────────────────────────────────────
xcuserdata/
*.xcuserstate
DerivedData/
*.hmap
*.ipa
*.dSYM/
*.dSYM.zip
Pods/

# ─── Web / Node ──────────────────────────────────────────────────────────────
node_modules/
.yarn/
npm-debug.log*
yarn-error.log*

# ─── Signing keys & credentials — never commit ───────────────────────────────
# Maven Central signing keys and publishing credentials belong in
# ~/.gradle/gradle.properties or CI secrets, never in this repository.
*.jks
*.keystore
*.gpg
secring.*
# Apple signing material.
*.mobileprovision
*.p12
*.certSigningRequest
*.cer

# Exported PGP keys and per-project secret env files.
*.asc
*.key
.envrc
secrets.properties

# ─── IDE ─────────────────────────────────────────────────────────────────────
# Ignore .idea contents, but SHARE the copyright profile so every contributor's
# IDE stamps the same header on new files. Note: this must be `.idea/*` and not
# `.idea/`, because git cannot re-include a path whose parent directory is excluded.
.idea/*
!.idea/copyright/
*.iml
*.ipr
*.iws
out/

# JetBrains Junie. Uncomment the negation to share guidelines with contributors.
.junie/
# !.junie/guidelines.md

# ─── Claude Code ─────────────────────────────────────────────────────────────
# Blanket-ignored: local settings, worktrees and session state should never reach
# a public repo. Negate a specific file here if you later want to share config.
.claude/

# ─── JVM crash logs ──────────────────────────────────────────────────────────
hs_err_pid*
replay_pid*

# ─── OS & editor cruft ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
*~
*.swp
# Merge / patch / editor leftovers.
*.orig
*.rej
*.bak

# Qodana local analysis output
.qodana/
