<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31) data extraction rules.

    android:allowBackup="false" already disables cloud backup on every version, but on API 31+ it does
    NOT cover device-to-device transfer — that is governed only by <device-transfer> below. Without this
    file the app's data would still be eligible for D2D transfer, which is what SonarSource S6358 is
    actually pointing at.

    Both sections exclude everything. This sample holds nothing worth carrying to another device: no
    account, no entitlement, no licence, no resume position. The only persistent state is whatever the
    player engine caches, and that is re-derivable from the network.

    Domains are listed for both credential-encrypted (root/file/database/sharedpref/external) and
    device-encrypted (device_*) storage, because an exclusion of the former says nothing about the
    latter — they are separate trees and default to included.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
