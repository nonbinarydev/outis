<?xml version="1.0" encoding="utf-8"?>
<!--
    The Outis mark: an open ring — an "O" with a deliberate gap, read as an eye that is not quite
    closed. No pupil and no triangle, both of which belong to other players' marks.

    108x108 is the adaptive-icon canvas; only the central 66x66 is guaranteed visible once a launcher
    applies its own mask, so the ring is sized to 52 across and centred to stay well inside that.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- A 300-degree arc from the top, leaving the gap at the lower left. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,28 A26,26 0 1 1 31.48,41"
        android:strokeColor="#F2EFE9"
        android:strokeLineCap="round"
        android:strokeWidth="9" />
</vector>
