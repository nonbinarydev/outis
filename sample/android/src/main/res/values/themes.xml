<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose supplies the real theming; this only needs to avoid a light flash before first frame
         and to keep the system bars legible over a dark player. -->
    <style name="Theme.Outis" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
